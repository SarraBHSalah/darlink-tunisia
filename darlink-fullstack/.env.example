PORT=8091
SESSION_SECRET=change-this-to-a-long-random-string
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password

# Optional — enables real email notifications when a contact form is submitted.
# Leave blank to skip: messages are still saved and visible in /admin.
# Example with Gmail: create an "App Password" in your Google account first.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
NOTIFY_EMAIL=contact@darlinktunisia.com
